---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import Section from "../../../components/Section.astro";

const partner = {
    name: "Nadine Campos",
    tagline: "photography & film production",
    logo: "/images/partners/SVG/logo-nadine-white.svg",
    bio: "Nadine Campos is a renowned photographer and film producer, recognized for her ability to capture the essence of every moment through an artistic and technical lens. With years of experience in the industry, Nadine specializes in productions that tell powerful visual stories, from product and real estate photography to commercial short films.",
    howWeWork:
        "Sueste Creative and Nadine Campos join forces to offer integrated visual solutions. While Sueste focuses on digital strategy and design, Nadine brings the magic of reality-based imagery, ensuring that visual content is world-class, elevating our clients' brand perception.",
    images: [
        "https://images.pexels.com/photos/34976564/pexels-photo-34976564.jpeg?auto=compress&cs=tinysrgb&w=1200", // Photographer
        "https://images.pexels.com/photos/323780/pexels-photo-323780.jpeg?auto=compress&cs=tinysrgb&w=1200", // Modern House
        "https://images.pexels.com/photos/1774931/pexels-photo-1774931.jpeg?auto=compress&cs=tinysrgb&w=1200", // Interior Design
        "https://images.pexels.com/photos/11467685/pexels-photo-11467685.jpeg?auto=compress&cs=tinysrgb&w=1200", // Drone View
    ],
    pricing: {
        photo: {
            title: "Photography (w/ editing)",
            packs: [
                { name: "Pack 15", price: "45€", frames: "Up to 90m²" },
                { name: "Pack 25", price: "65€", frames: "Up to 120m²" },
                { name: "Pack 35", price: "90€", frames: "Up to 200m²" },
                { name: "Pack 50", price: "115€", frames: "+250 m²" },
            ],
            addons: [
                { name: "Extra framing", price: "3.50€ / unit" },
                { name: "Image retouching", price: "2.00€ to 25.00€" },
                { name: "Virtual staging", price: "2.00€ to 25.00€" },
                { name: "Sky replacement", price: "5.00€" },
            ],
        },
        video: {
            title: "Video (w/ editing)",
            packs: [
                { name: "Standard Video", price: "120.00€", duration: "1 min" },
                { name: "Video w/ Drone", price: "180.00€", duration: "2 min" },
                {
                    name: "Reels Video",
                    price: "50.00€",
                    duration: "Extra 30 to 45 sec",
                },
            ],
            addons: [
                { name: "Extra minute", price: "15€" },
                { name: "Titles / Subtitles", price: "2.00€ per layer" },
                { name: "Logo animation", price: "5.00€" },
                { name: "Graphic elements", price: "2.00€ to 15.00€" },
            ],
        },
    },
};
---

<BaseLayout
    title={partner.name}
    description={`Learn more about our partnership with ${partner.name}.`}
    lang="en"
>
    <Navbar />

    <main class="partner-detail-page">
        <header class="partner-hero">
            <div class="container hero-inner">
                <div class="logo-reveal" data-reveal>
                    <img
                        src={partner.logo}
                        alt={partner.name}
                        class="partner-logo"
                    />
                </div>
                <h1 class="reveal-text" data-reveal>
                    <span class="partner-name-hero">{partner.name}</span>
                    <span class="partner-tagline-hero">{partner.tagline}</span>
                </h1>
                <div class="hero-line"></div>
            </div>
        </header>

        <Section id="bio" title="About the Artist" className="bio-section">
            <div class="bio-container grid">
                <div class="bio-text" data-reveal>
                    <p>{partner.bio}</p>
                </div>
                <div class="bio-image">
                    <div class="nadine-portrait-wrap">
                        <img
                            src="/images/partners/nadine-portrait.webp"
                            alt="Nadine Campos"
                            class="nadine-portrait"
                        />
                    </div>
                </div>
            </div>
        </Section>

        <Section id="pricing" title="Services & Packs" dark centered>
            <div class="pricing-tabs">
                <div class="pricing-category">
                    <h3>{partner.pricing.photo.title}</h3>
                    <div class="packs-grid">
                        {
                            partner.pricing.photo.packs.map((pack) => (
                                <div class="pack-item glass">
                                    <span class="pack-name">{pack.name}</span>
                                    <span class="pack-price">{pack.price}</span>
                                    <span class="pack-detail">
                                        {pack.frames}
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                    <ul class="addons-list">
                        {
                            partner.pricing.photo.addons.map((addon) => (
                                <li>
                                    <span class="addon-name">{addon.name}</span>
                                    <span class="addon-price">
                                        +{addon.price}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="pricing-category">
                    <h3>{partner.pricing.video.title}</h3>
                    <div class="packs-grid">
                        {
                            partner.pricing.video.packs.map((pack, idx) => (
                                <div
                                    class={`pack-item glass highlight ${idx === 2 ? "span-full" : ""}`}
                                >
                                    <span class="pack-name">{pack.name}</span>
                                    <span class="pack-price">{pack.price}</span>
                                    <span class="pack-detail">
                                        {pack.duration}
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                    <ul class="addons-list">
                        {
                            partner.pricing.video.addons.map((addon) => (
                                <li>
                                    <span class="addon-name">{addon.name}</span>
                                    <span class="addon-price">
                                        +{addon.price}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </Section>

        <Section id="terms" title="Terms & Conditions" dark centered>
            <div class="terms-grid">
                <div class="term-card" data-reveal>
                    <h4>Travel</h4>
                    <p>
                        Free within 15km. Beyond this limit, a 0.30€/km fee
                        (round trip) and applicable tolls apply.
                    </p>
                </div>
                <div class="term-card" data-reveal>
                    <h4>Revisions</h4>
                    <p>
                        1 free revision included. Extra technical changes quoted
                        separately.
                    </p>
                </div>
                <div class="term-card" data-reveal>
                    <h4>Loyalty</h4>
                    <p>
                        5% discount from your 5th appointment. 10% discount from
                        your 10th appointment with us.
                    </p>
                </div>
                <div class="term-card" data-reveal>
                    <h4>Delivery</h4>
                    <p>
                        Files delivered in digital format with guaranteed
                        storage for 6 months.
                    </p>
                </div>
            </div>
        </Section>

        <Section id="collaboration" title="How We Work" centered>
            <div class="collab-container">
                <div class="collab-content" data-reveal>
                    <div class="collab-card glass">
                        <div class="collab-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
                        <h3>Strategic Synergy</h3>
                        <p>{partner.howWeWork}</p>
                    </div>
                </div>
            </div>
        </Section>

        <Section id="cta" className="final-cta">
            <div class="cta-inner text-center">
                <h2>Ready to elevate your project?</h2>
                <p>
                    Request a quote to combine these services with our digital
                    strategy.
                </p>
                <div style="margin-top: 3rem;">
                    <a href="/en/quote" class="btn-cta">Request Quote</a>
                </div>
            </div>
        </Section>
    </main>

    <Footer />
</BaseLayout>

<style>
    .partner-detail-page {
        padding-top: 200px;
    }

    .partner-hero {
        min-height: 40vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .partner-logo {
        height: 185px;
        width: auto;
        border-radius: 20px;
        margin-bottom: 2rem;
    }

    .partner-name-hero {
        display: block;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .partner-tagline-hero {
        font-size: 1.25rem;
        font-weight: 300;
        font-style: italic;
        color: #a1a1aa;
        letter-spacing: 0.1em;
    }

    .hero-line {
        width: 60px;
        height: 4px;
        background: #38bdf8;
        margin: 2rem auto 0;
    }

    .bio-section :global(.section-header) {
        margin-bottom: 2rem;
    }

    .cta-inner {
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
    }

    .bio-container {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 5rem;
        align-items: center;
    }

    .bio-text p {
        font-size: 1.2rem;
        line-height: 1.8;
        color: #a1a1aa;
    }

    .bio-image {
        display: flex;
        justify-content: center;
    }

    .nadine-portrait-wrap {
        width: 100%;
        max-width: 360px;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
        perspective: 700px;
        transform-style: preserve-3d;
        clip-path: inset(100% 0% 0% 0% round 24px);
        opacity: 0;
        cursor: default;
    }

    .nadine-portrait {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        object-position: center top;
        will-change: transform;
        transform-origin: center center;
    }

    @media (max-width: 991px) {
        .nadine-portrait-wrap {
            max-width: 280px;
        }
    }

    .pricing-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
    }

    .pricing-category h3 {
        font-size: 1.8rem;
        margin-bottom: 2rem;
        color: #fff;
        border-bottom: 2px solid rgba(56, 189, 248, 0.3);
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .packs-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .pack-item {
        padding: 1.5rem;
        border-radius: 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .pack-item.highlight {
        border-color: rgba(56, 189, 248, 0.3);
        background: rgba(56, 189, 248, 0.02);
    }

    .pack-name {
        font-weight: 700;
        font-size: 1.1rem;
    }

    .pack-price {
        font-size: 1.5rem;
        font-weight: 800;
        color: #38bdf8;
    }

    .pack-detail {
        font-size: 0.8rem;
        color: #71717a;
    }

    .addons-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .addons-list li {
        display: flex;
        justify-content: space-between;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .addon-name {
        font-weight: 500;
    }

    .addon-price {
        color: #38bdf8;
        font-weight: 700;
    }

    .collab-card {
        padding: 3rem;
        border-radius: 32px;
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
    }

    .terms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
    }

    .term-card {
        padding: 2.25rem;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .span-full {
        grid-column: span 2;
    }

    @media (max-width: 768px) {
        .span-full {
            grid-column: span 1;
        }
    }

    .term-card h4 {
        color: #38bdf8;
        margin-bottom: 1rem;
    }

    .btn-cta {
        display: inline-block;
        padding: 1.25rem 3rem;
        background: #fff;
        color: #000;
        border-radius: 100px;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.3s ease;
    }

    .btn-cta:hover {
        transform: scale(1.05);
    }

    @media (max-width: 991px) {
        .pricing-tabs,
        .bio-container {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const wrap = document.querySelector<HTMLElement>(".nadine-portrait-wrap");
    if (wrap) {
        gsap.to(wrap, {
            clipPath: "inset(0% 0% 0% 0% round 24px)",
            opacity: 1,
            duration: 1.1,
            ease: "expo.out",
            scrollTrigger: {
                trigger: wrap,
                start: "top 82%",
                toggleActions: "play none none none",
            },
        });

        const img = wrap.querySelector<HTMLElement>(".nadine-portrait");
        if (img) {
            wrap.addEventListener("mousemove", (e: MouseEvent) => {
                const r = wrap.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width - 0.5;
                const y = (e.clientY - r.top) / r.height - 0.5;
                gsap.to(img, {
                    rotationY: x * 14,
                    rotationX: -y * 14,
                    scale: 1.04,
                    duration: 0.35,
                    ease: "power2.out",
                    transformPerspective: 700,
                });
            });

            wrap.addEventListener("mouseleave", () => {
                gsap.to(img, {
                    rotationY: 0,
                    rotationX: 0,
                    scale: 1,
                    duration: 0.75,
                    ease: "elastic.out(1, 0.6)",
                });
            });
        }
    }
</script>
