---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
    title="Casa da Avó"
    category="Bookings & Payments"
    client="Casa da Avó · Praia da Luz"
    year="2026"
    description="A direct-booking website for a villa in Praia da Luz, with staged 30/70 Stripe payments and a running cost of €2.80 a month."
    heroImage="/images/portfolio/casa-da-avo/hero.webp"
    lang="en"
    metrics={[
        { label: "Monthly Site Cost", value: "€2.80" },
        { label: "Middleman Commission", value: "0%" },
        { label: "Automated Payment", value: "30/70" },
    ]}
>
    <div class="container project-content-grid">
        <div class="project-text-block" data-reveal>
            <h2>The Challenge</h2>
            <p>
                Casa da Avó is a private villa in Praia da Luz — three bedrooms,
                a pool, panoramic Atlantic views and room for six. A single
                property, run by a family, not a hotel chain.
            </p>
            <p>
                Booking portals take a commission on every stay. And a CMS site
                with a booking plugin swaps that commission for a different
                bill: hosting, licences, updates and a monthly fee that keeps
                running in the months the house sits empty.
            </p>
            <p>
                For a single house with a defined season, neither of those adds
                up.
            </p>
        </div>

        <div class="project-media project-media-right" data-reveal>
            <img
                src="/images/portfolio/casa-da-avo/booking-flow.webp"
                alt="Casa da Avó booking calendar on a phone, showing instant booking with no middlemen and no platform fees"
                class="rounded-xl w-full"
                width="1600"
                height="900"
                loading="lazy"
            />
        </div>

        <div class="solution-section" data-reveal>
            <div class="project-text-block solution-content">
                <h2>The Solution</h2>
                <p>
                    We built the site with nothing in it that demands paid
                    upkeep. No CMS, no database billing by the month, no plugins
                    to renew. Booking management and payments live inside the
                    site itself, and Stripe only charges when a booking comes
                    in.
                </p>
            </div>
        </div>

        <div class="cost-section" data-reveal>
            <span class="cost-label">What the site costs to run</span>
            <span class="cost-figure">€2.80<small>/mo</small></span>
            <p class="cost-line">The domain. That's it.</p>
            <p class="cost-sub">
                No hosting bill, no CMS, no plugins, no licences to renew.
                Stripe only charges when a booking comes in.
            </p>
        </div>

        <div class="solution-section" data-reveal>
            <div class="project-text-block solution-content">
                <h2>Staged 30/70 Payments</h2>
                <p>
                    A week-long stay shouldn't be charged like a pair of shoes.
                    The guest pays <strong>30% at the moment of booking</strong>
                    to lock in the dates, and the remaining <strong>70% is
                    charged 14 days before arrival</strong>.
                </p>
                <p>
                    The deposit cuts cancellation risk without asking a guest to
                    front the whole stay months before they travel — and the
                    balance is collected automatically, with no reminders to
                    send and no bank transfers to chase.
                </p>
            </div>
        </div>

        <div class="solution-section" data-reveal>
            <div class="project-text-block solution-content">
                <h2>Direct Bookings, Direct Relationship</h2>
                <p>
                    Every booking made on the site is a booking without a
                    middleman: no commission, and guest details that belong to
                    the person who owns the house. A site that works through
                    high season and charges nothing through the low one.
                </p>
            </div>
        </div>

        <div class="project-cta" data-reveal>
            <a
                href="https://www.casadaavo.online/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-live"
            >
                Visit casadaavo.online
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                        points="7 7 17 7 17 17"></polyline></svg
                >
            </a>
        </div>
    </div>
</ProjectLayout>

<style>
    .project-content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
        margin-top: 4rem;
    }

    .project-text-block {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .solution-section {
        grid-column: 1 / -1;
        width: 100%;
        margin-top: 4rem;
    }

    .solution-content {
        max-width: 100%;
    }

    .project-text-block h2 {
        font-size: 2.5rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 1rem;
        position: relative;
        display: inline-block;
    }

    .project-text-block h2::after {
        content: "";
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 60px;
        height: 4px;
        background: #f97316;
        border-radius: 2px;
    }

    .project-text-block p {
        font-size: 1.1rem;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.7);
    }

    .project-text-block strong {
        color: #fff;
        font-weight: 700;
    }

    .project-media img {
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 24px;
        transition: transform 0.8s ease;
    }

    .project-media:hover img {
        transform: scale(1.02);
    }

    /* ── RUNNING COST ───────────────────────────────────────────────── */
    .cost-section {
        grid-column: 1 / -1;
        margin-top: 5rem;
        padding: 3.5rem 2.5rem;
        border-radius: 24px;
        border: 1px solid rgba(249, 115, 22, 0.25);
        background: rgba(249, 115, 22, 0.05);
        text-align: center;
    }

    .cost-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: rgba(255, 255, 255, 0.5);
    }

    .cost-figure {
        display: block;
        margin-top: 0.75rem;
        font-size: clamp(3.5rem, 10vw, 6rem);
        font-weight: 900;
        line-height: 1;
        color: #f97316;
        letter-spacing: -0.04em;
    }

    .cost-figure small {
        font-size: 0.25em;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.45);
        letter-spacing: 0;
    }

    .cost-line {
        margin: 1.25rem 0 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
    }

    .cost-sub {
        margin: 1rem auto 0;
        max-width: 46ch;
        font-size: 1rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.55);
    }

    /* ── CTA ────────────────────────────────────────────────────────── */
    .project-cta {
        grid-column: 1 / -1;
        display: flex;
        justify-content: center;
        margin-top: 5rem;
    }

    .btn-live {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 1rem 2.25rem;
        border-radius: 50px;
        border: 1px solid rgba(249, 115, 22, 0.4);
        background: rgba(249, 115, 22, 0.08);
        color: #f97316;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-live:hover {
        background: rgba(249, 115, 22, 0.16);
        transform: translateY(-2px);
    }

    @media (max-width: 900px) {
        .project-content-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .project-media-left,
        .project-media-right {
            order: 0;
        }

        .project-text-block h2 {
            font-size: 2rem;
        }

        .cost-section {
            padding: 2.5rem 1.5rem;
        }
    }
</style>
