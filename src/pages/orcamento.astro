---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import BudgetCalculator from "../components/BudgetCalculator.tsx";
import WhatsAppButton from "../components/WhatsAppButton.astro";
---

<BaseLayout
  title="Personalize o seu Plano"
  description="Calcule o custo do seu projeto digital com a Sueste Creative. Website, loja online, redes sociais — preços transparentes, sem surpresas."
  hreflangPt="https://sueste-creative.pt/orcamento"
  hreflangEn="https://sueste-creative.pt/en/quote"
>
  <Navbar />

  <main class="quote-page">
    <Section
      title="Personalize o seu Plano"
      subtitle="Personalize os serviços de que necessita e obtenha uma estimativa transparente em tempo real. Sem compromissos."
    >
      <BudgetCalculator client:visible lang="pt" />
      <div class="quote-wa">
        <p>Prefere falar diretamente?</p>
        <WhatsAppButton
          lang="pt"
          source="orcamento_page"
          variant="cta"
          message="Olá Pedro, gostaria de falar sobre um orçamento."
        />
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .quote-page {
    padding-top: 120px;
    background: #09090b; /* Dark theme to match the glassmorphism */
    min-height: 100vh;
  }

  .quote-wa {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .quote-wa p {
    margin: 0;
    opacity: 0.6;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .quote-page {
      padding-top: 80px;
    }
  }
</style>
