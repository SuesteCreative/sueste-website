---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
---

<BaseLayout
  title="Contacto: Proposta Gratuita em 48 Horas"
  description="Fale com a Sueste Creative. Conte-nos o seu projeto e receba uma proposta personalizada em menos de 48 horas. Sem compromissos."
  hreflangPt="https://sueste-creative.pt/contacto"
  hreflangEn="https://sueste-creative.pt/en/contact"
>
  <Navbar />
  <main class="contact-page">
    <Section
      title="Vamos Conversar"
      subtitle="Traga a sua ideia e nós damos-lhe vida."
    >
      <div class="contact-grid">
        <div class="contact-info" data-reveal>
          <div class="info-item">
            <h4>E-mail</h4>
            <p><a href="mailto:info@sueste-creative.pt">info@sueste-creative.pt</a></p>
          </div>
          <div class="info-item">
            <h4>WhatsApp</h4>
            <p><WhatsAppButton lang="pt" source="contacto_page" /></p>
          </div>
          <div class="info-item">
            <h4>Localização</h4>
            <p>Lisboa/Portimão, Portugal</p>
          </div>
          <div class="info-item">
            <h4>Redes Sociais</h4>
            <div class="social-links">
              <a href="https://www.instagram.com/sueste.agency/" target="_blank" rel="noopener noreferrer">Instagram</a>
              <a href="https://www.facebook.com/sueste.agency" target="_blank" rel="noopener noreferrer">Facebook</a>
              <a href="https://linkedin.com/company/sueste-creative" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </div>
          </div>
        </div>

        <div class="contact-form-wrapper glass reveal-delay-1" data-reveal>
          <form class="contact-form" id="contactForm" novalidate>
            <!-- Honeypot -->
            <input type="text" name="honey" style="display:none" tabindex="-1" autocomplete="off" />
            <div class="form-group">
              <label for="name">Nome</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="O seu nome"
                required
              />
            </div>
            <div class="form-group">
              <label for="email">E-mail</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="o-seu@email.com"
                required
              />
            </div>
            <div class="form-group">
              <label for="message">Mensagem</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Como podemos ajudar?"
                required></textarea>
            </div>
            <div class="privacy-check">
              <input type="checkbox" id="privacyConsent" required />
              <label for="privacyConsent">
                Li e aceito a <a href="/privacidade" target="_blank">Política de Privacidade</a>
              </label>
            </div>
            <div class="form-feedback" id="formFeedback" aria-live="polite"></div>
            <button type="submit" class="btn-submit" id="submitBtn">Enviar Mensagem</button>
          </form>
        </div>
      </div>
    </Section>

    <Section
      title="Perguntas Frequentes"
      subtitle="Algumas das dúvidas mais comuns dos nossos clientes."
      dark
      centered
    >
      <div class="faq-container">
        <div class="faq-item glass" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>Quanto tempo demora um projeto?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Depende da complexidade. Um website institucional médio demora entre 3 a 6 semanas, enquanto um e-commerce ou sistema customizado pode levar 2 a 4 meses.</p>
            </div>
          </div>
        </div>

        <div class="faq-item glass reveal-delay-1" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>Qual o custo de um website profissional?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Cada projeto é único, por isso os preços variam conforme o âmbito e os requisitos. O nosso orçamento é sempre gratuito e personalizado. Use a nossa <a href="/orcamento">calculadora de orçamento</a> para ter uma estimativa inicial.</p>
            </div>
          </div>
        </div>

        <div class="faq-item glass reveal-delay-2" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>Trabalham com clientes internacionais?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Sim! Embora estejamos em Lisboa e Portimão, Portugal, trabalhamos com clientes de todo o mundo de forma 100% remota e eficiente.</p>
            </div>
          </div>
        </div>

        <div class="faq-item glass" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>Como funciona o processo de pagamento?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Normalmente dividimos o pagamento em 3 fases: adjudicação (50%), após aprovação do design (25%) e antes do lançamento (25%).</p>
            </div>
          </div>
        </div>

        <div class="faq-item glass reveal-delay-1" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>Oferecem suporte e manutenção após o lançamento?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Sim. Oferecemos planos de manutenção mensal que incluem atualizações de segurança, backups regulares, monitorização de desempenho e suporte técnico prioritário.</p>
            </div>
          </div>
        </div>

        <div class="faq-item glass reveal-delay-2" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>O meu website vai aparecer no Google?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Todos os nossos projetos incluem SEO técnico de base: estrutura semântica, meta tags, velocidade de carregamento otimizada e dados estruturados. Para estratégias de SEO avançadas e criação de conteúdo, temos pacotes dedicados.</p>
            </div>
          </div>
        </div>

        <div class="faq-item glass" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>Posso gerir o conteúdo do meu website sozinho?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Sim. Dependendo do projeto, integramos sistemas de gestão de conteúdo (CMS) intuitivos que lhe permitem atualizar textos, imagens e produtos sem qualquer conhecimento técnico. Incluímos sempre formação básica de utilização.</p>
            </div>
          </div>
        </div>

        <div class="faq-item glass reveal-delay-1" data-reveal>
          <button class="faq-trigger" aria-expanded="false">
            <h3>Quais os serviços que a Sueste Creative oferece?</h3>
            <div class="faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
          </button>
          <div class="faq-content">
            <div class="faq-content-inner">
              <p>Oferecemos web design e desenvolvimento, criação de lojas online (e-commerce), branding e identidade visual, marketing digital, SEO e gestão de redes sociais. Conheça todos os nossos <a href="/servicos">serviços</a>.</p>
            </div>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Quanto tempo demora um projeto?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Depende da complexidade. Um website institucional médio demora entre 3 a 6 semanas, enquanto um e-commerce ou sistema customizado pode levar 2 a 4 meses."
        }
      },
      {
        "@type": "Question",
        "name": "Qual o custo de um website profissional?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cada projeto é único, por isso os preços variam conforme o âmbito e os requisitos. O orçamento é sempre gratuito e personalizado."
        }
      },
      {
        "@type": "Question",
        "name": "Trabalham com clientes internacionais?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim! Embora estejamos em Lisboa e Portimão, Portugal, trabalhamos com clientes de todo o mundo de forma 100% remota e eficiente."
        }
      },
      {
        "@type": "Question",
        "name": "Como funciona o processo de pagamento?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Normalmente dividimos o pagamento em 3 fases: adjudicação (50%), após aprovação do design (25%) e antes do lançamento (25%)."
        }
      },
      {
        "@type": "Question",
        "name": "Oferecem suporte e manutenção após o lançamento?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim. Oferecemos planos de manutenção mensal que incluem atualizações de segurança, backups regulares, monitorização de desempenho e suporte técnico prioritário."
        }
      },
      {
        "@type": "Question",
        "name": "O meu website vai aparecer no Google?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Todos os nossos projetos incluem SEO técnico de base: estrutura semântica, meta tags, velocidade de carregamento otimizada e dados estruturados."
        }
      },
      {
        "@type": "Question",
        "name": "Posso gerir o conteúdo do meu website sozinho?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim. Dependendo do projeto, integramos sistemas de gestão de conteúdo (CMS) intuitivos que lhe permitem atualizar textos, imagens e produtos sem qualquer conhecimento técnico."
        }
      },
      {
        "@type": "Question",
        "name": "Quais os serviços que a Sueste Creative oferece?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Oferecemos web design e desenvolvimento, criação de lojas online (e-commerce), branding e identidade visual, marketing digital, SEO e gestão de redes sociais."
        }
      }
    ]
  })}</script>

  <Footer />
</BaseLayout>

<style>
  .contact-page {
    padding-top: 80px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: start;
  }

  .info-item {
    margin-bottom: 2rem;
  }

  .info-item h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .info-item p {
    font-size: 1.2rem;
    opacity: 0.8;
  }

  .info-item p a {
    opacity: 0.8;
    transition: color 0.3s;
  }

  .info-item p a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .social-links a {
    font-size: 0.9rem;
    opacity: 0.6;
    transition: opacity 0.3s;
  }

  .social-links a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .contact-form-wrapper {
    padding: 3rem;
    border-radius: 30px;
  }

  .form-group {
    margin-bottom: 2rem;
  }

  .form-group label {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    opacity: 0.7;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: white;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-feedback {
    min-height: 1.5rem;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .form-feedback.success {
    color: #4ade80;
  }

  .form-feedback.error {
    color: #f87171;
  }

  .privacy-check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .privacy-check input[type="checkbox"] {
    width: 18px;
    height: 18px;
    min-width: 18px;
    margin-top: 2px;
    accent-color: var(--color-accent-dark);
    cursor: pointer;
  }

  .privacy-check label {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.5;
    cursor: pointer;
  }

  .privacy-check label a {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }

  .btn-submit {
    width: 100%;
    padding: 1rem 2rem;
    background: var(--color-accent-dark);
    color: #fff;
    border: none;
    border-radius: 50px;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 0.02em;
  }

  .btn-submit:hover:not(:disabled) {
    background: #0060d0;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 112, 243, 0.35);
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .faq-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-item {
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .faq-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  .faq-item.active {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-accent);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: white;
  }

  .faq-trigger h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .faq-item:hover .faq-trigger h3 {
    color: var(--color-accent);
  }

  .faq-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  .faq-icon svg {
    width: 18px;
    height: 18px;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-item.active .faq-icon {
    background: var(--color-accent);
  }

  .faq-item.active .faq-icon svg {
    transform: rotate(180deg);
  }

  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-item.active .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-content-inner {
    overflow: hidden;
  }

  .faq-content p {
    padding: 0 2rem 2rem 2rem;
    margin: 0;
    opacity: 0.7;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .faq-content p a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-form-wrapper {
      padding: 2rem;
    }

    .faq-trigger {
      padding: 1.5rem;
    }

    .faq-trigger h3 {
      font-size: 1.1rem;
    }

    .faq-content p {
      padding: 0 1.5rem 1.5rem 1.5rem;
    }
  }
</style>

<script>
  // ── FAQ Accordion ──────────────────────────────────────────
  function setupAccordion() {
    const items = document.querySelectorAll(".faq-item");

    items.forEach((item) => {
      const trigger = item.querySelector(".faq-trigger");
      if (!trigger) return;

      trigger.addEventListener("click", () => {
        const isOpen = item.classList.contains("active");

        items.forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.classList.remove("active");
            otherItem.querySelector(".faq-trigger")?.setAttribute("aria-expanded", "false");
          }
        });

        item.classList.toggle("active");
        trigger.setAttribute("aria-expanded", (!isOpen).toString());
      });
    });
  }

  setupAccordion();
  document.addEventListener("astro:after-swap", setupAccordion);

  // ── Contact Form ───────────────────────────────────────────
  function setupContactForm() {
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    const feedback = document.getElementById("formFeedback");
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;

    if (!form || !feedback || !submitBtn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = "A enviar…";
      feedback.className = "form-feedback";
      feedback.textContent = "";

      const formData = new FormData(form);
      const data = {
        honey: formData.get("honey"),
        name: formData.get("name"),
        email: formData.get("email"),
        message: formData.get("message"),
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        const result = await res.json();

        if (result.success) {
          feedback.className = "form-feedback success";
          feedback.textContent = "Mensagem enviada com sucesso! Respondemos em menos de 48 horas.";
          form.reset();
        } else {
          feedback.className = "form-feedback error";
          feedback.textContent = result.error || "Ocorreu um erro. Por favor tente novamente.";
        }
      } catch {
        feedback.className = "form-feedback error";
        feedback.textContent = "Ocorreu um erro de ligação. Por favor tente novamente.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar Mensagem";
      }
    });
  }

  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>
