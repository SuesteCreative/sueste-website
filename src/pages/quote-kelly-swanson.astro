---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const preparedDate = "June 23, 2026";
const validUntil = "July 23, 2026";

const features = [
  {
    accent: "#38bdf8",
    name: "Real Estate Website + Full CMS",
    price: "€2,500",
    priceNote: "one-time",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 21V9h6v12"/><path d="M3 9h18"/>`,
    items: [
      "Custom-designed site built for international buyers",
      "Unlimited property listings, add, edit, remove yourself, no coding",
      "Property pages: photo gallery, map, price, features, status (For Sale / Sold / Reserved)",
      "Search & filter by location, price, bedrooms, type",
      "Mobile-first, fast-loading, SEO-structured",
      "Up to 5 rounds of design revisions included",
      "Always open to new ideas and feedback along the way, regardless of revision count",
      "English-language site at launch, additional languages available as an add-on",
    ],
  },
  {
    accent: "#6366f1",
    name: "Built-in CRM",
    price: "Included",
    priceNote: "basic CRM",
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>`,
    items: [
      "Contact list, every listing enquiry flows in automatically",
      "Work pipeline: New → Contacted → Viewing → Offer → Closed",
      "Built-in email sender for follow-ups",
      "Advanced CRM features available as an add-on, see below",
      "30-minute handoff call so you're comfortable running the CMS and CRM yourself",
    ],
  },
  {
    accent: "#fbbf24",
    name: "Blog Section",
    price: "Included",
    priceNote: "",
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
    items: [
      "Publish posts yourself, no developer needed",
      "Ideal for tax-regime guides per country, market updates, buyer guides",
      "SEO-structured templates with categories and tags",
      "Want us to write the posts? See the optional plans below",
    ],
  },
  {
    accent: "#34d399",
    name: "Consulting Bookings",
    price: "Included",
    priceNote: "Calendly + Stripe",
    icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
    items: [
      "Dedicated \"Book a Consultation\" page",
      "Calendly embed for scheduling",
      "Stripe Checkout, clients pay upfront, session confirms automatically",
      "Automatic confirmation emails",
    ],
  },
  {
    accent: "#a78bfa",
    name: "SEO + GEO",
    price: "Included",
    priceNote: "",
    icon: `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>`,
    items: [
      "On-page SEO: meta, schema, sitemaps, tuned for international property search",
      "GEO (Generative Engine Optimization), structured so AI search/answer engines surface your listings",
      "Google Analytics + Search Console setup included",
    ],
  },
  {
    accent: "#fb923c",
    name: "Post-Launch Support",
    price: "Included",
    priceNote: "first 12 months",
    icon: `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m9.17 14.83-4.24 4.24"/>`,
    items: [
      "1 major update every 3 months for the first year, at no extra cost",
      "Small bug fixes and adjustments aren't charged, as long as it's within reason",
      "After 12 months, further major updates are quoted individually",
    ],
  },
  {
    accent: "#f472b6",
    name: "Brandbook",
    price: "Optional",
    priceNote: "quoted later",
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><circle cx="11.5" cy="9" r="2"/>`,
    items: [
      "Logo refinement, color palette, typography, brand guidelines",
      "Only if you feel you need one, not required to launch",
      "We'll scope and quote this separately once you decide",
    ],
  },
];

const pricingRows = [
  { label: "Real Estate Website + Full CMS", price: "€2,500", note: "one-time" },
  { label: "Built-in CRM (contact list, pipeline, email sender)", price: "Included", note: "" },
  { label: "Calendly + Stripe Consulting Bookings", price: "Included", note: "" },
  { label: "SEO + GEO", price: "Included", note: "" },
  { label: "Blog Section", price: "Included", note: "" },
  { label: "Post-Launch Support (1 major update / 3 months)", price: "Included", note: "first 12 months" },
];

const addonRows = [
  {
    label: "Advanced CRM (premium features)",
    price: "€500 – €1,000",
    note: "depending on complexity",
    desc: "Automated follow-up email sequences, lead scoring & tagging, deal value tracking, team accounts for additional agents, and custom reporting dashboards.",
  },
  { label: "Blog writing, 1 post/week", price: "€150", note: "/month" },
  { label: "Blog writing, 2–3 posts/week", price: "€300", note: "/month" },
  { label: "Blog writing, 3+ posts/week", price: "€500", note: "/month" },
  { label: "Additional language (e.g. Portuguese)", price: "€400", note: "one-time" },
];

const notIncludedRows = [
  { label: "Domain registration & renewal", note: "~€12–20/year, billed by registrar, registered in your name, you own it" },
  { label: "Database upgrades", note: "Free tier (Neon/Supabase) covers a generous amount of data, no cost to you. If you ever outgrow it: Neon from $19/month (10 GB), Supabase from $25/month (8 GB), billed directly to you, only if needed" },
  { label: "Calendly & Stripe", note: "Calendly's free tier works fine. If you choose to upgrade, that's billed directly to you by Calendly. Stripe's processing fees also apply per transaction." },
  { label: "Company email", note: "Not included" },
  { label: "Paid ad spend", note: "Google Ads / social ads budget, management quoted separately" },
  { label: "Property listing data entry", note: "You (or your team) add listings via the CMS" },
  { label: "Ongoing blog writing", note: "Unless one of the monthly plans above is selected" },
  { label: "Property photography", note: "Not included, supply your own or we can recommend a photographer" },
  { label: "Migration of existing listings/content", note: "Included for reasonable volume, large catalogs quoted separately" },
];

const timeline = [
  { phase: "Within 48 hours", title: "First Draft & Agreement", desc: "After you submit your selections below, you'll receive a first draft of the agreement within 48 hours. Once you approve it and the first payment is made, development begins." },
  { phase: "Week 1", title: "Discovery & Design", desc: "Brand direction, sitemap, wireframes for listings and consulting pages." },
  { phase: "Weeks 1–2", title: "Website + Full CMS + CRM Build", desc: "Full build of the site, the property management system, and the contact pipeline." },
  { phase: "Week 3", title: "Calendly + Stripe, SEO + GEO", desc: "Consulting bookings go live with payment; SEO/GEO foundations applied." },
  {
    blackout: true,
    phase: "July 18 – August 2",
    title: "Pedro unavailable, wedding & honeymoon",
    desc: "No development work during this window. If the project is in progress when this date arrives, it simply pauses and picks back up right after, nothing is lost.",
  },
  { phase: "Final week", title: "Content, QA & Launch", desc: "Listings and blog content loaded, final testing, go live." },
];
---

<BaseLayout
  title="Proposal for Kelly Swanson"
  description="Business proposal and quote prepared by Sueste Creative Agency for Kelly Swanson, Portugal Property Specialist."
  lang="en"
  noindex={true}
>
  <main class="proposal-page">
    <div class="bg-blob" aria-hidden="true"></div>
    <header class="proposal-header">
      <div class="container header-inner">
        <img src="/images/logo-white-hor.webp" alt="Sueste Creative" class="logo" />
        <div class="header-right">
          <span class="header-tag">Business Proposal</span>
          <a href="https://sueste-creative.pt" target="_blank" rel="noopener" class="header-pill">Visit Website</a>
        </div>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero">
      <img
        src="/images/quote-kelly/hero-villa.jpg"
        alt="Modern villa with infinity pool"
        class="hero-bg"
        fetchpriority="high"
      />
      <div class="hero-scrim"></div>
      <div class="container hero-content">
        <div class="hero-meta" data-reveal>
          <span class="eyebrow">Project SW26-14</span>
        </div>
        <h1 class="hero-title" data-reveal>
          A real estate platform built for <span class="highlight">international buyers, run by you</span>
        </h1>
        <p class="hero-subtitle" data-reveal>
          A self-managed website with unlimited listings, a built-in CRM for every lead,
          a blog for your buyer guides, and a paid consulting booking flow, all in one system.
        </p>
        <div class="hero-dates" data-reveal>
          <div><span class="label">Prepared</span><span class="value">{preparedDate}</span></div>
          <div><span class="label">Valid until</span><span class="value">{validUntil}</span></div>
          <div><span class="label">Prepared by</span><span class="value">Sueste Creative Agency</span></div>
        </div>
      </div>
    </section>

    <!-- UNDERSTANDING -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>What we understood from our conversation</h2>
        </div>
        <div class="understanding-grid" data-reveal>
          <p>
            You work with property buyers from <strong>10–12 different countries</strong>, and what sets you
            apart is the personal relationship you build with each one. Your current setup makes it hard to
            scale that, listings need a developer to update, leads live in your inbox instead of a pipeline,
            and there's no easy way to turn your knowledge (like tax regimes for different nationalities) into
            content that brings buyers to you.
          </p>
          <p>
            This proposal is built around three goals: let you <strong>add and manage listings yourself</strong>,
            never lose a lead because it's not tracked anywhere, and let you charge for your time through paid,
            calendar-booked consultations.
          </p>
        </div>
      </div>
    </section>

    <!-- WHAT WE'LL BUILD -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>What we'll build</h2>
          <p>Five pieces, working as one system.</p>
        </div>
        <div class="feature-grid">
          {features.map((f) => (
            <div class="feature-card" data-reveal style={`--accent:${f.accent}`}>
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
              </div>
              <h3>{f.name}</h3>
              <ul>
                {f.items.map((item) => <li>{item}</li>)}
              </ul>
              <div class="feature-price">
                <span class="price">{f.price}</span>
                {f.priceNote && <span class="price-note">{f.priceNote}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- REFERENCE SITES -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>Show us what you like</h2>
          <p>Paste links to 3 real estate (or any) websites whose look and feel you like. We'll use them as visual direction for your design.</p>
        </div>
        <div class="ref-sites" data-reveal>
          <div class="kf-field">
            <label for="kf-ref-1">Website 1</label>
            <input id="kf-ref-1" name="refSite1" type="url" placeholder="https://..." />
          </div>
          <div class="kf-field">
            <label for="kf-ref-2">Website 2</label>
            <input id="kf-ref-2" name="refSite2" type="url" placeholder="https://..." />
          </div>
          <div class="kf-field">
            <label for="kf-ref-3">Website 3</label>
            <input id="kf-ref-3" name="refSite3" type="url" placeholder="https://..." />
          </div>
        </div>
      </div>
    </section>

    <!-- INVESTMENT -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>Investment</h2>
          <p>One flat price for the full platform. No hidden line items.</p>
        </div>
        <div class="pricing-table" data-reveal>
          {pricingRows.map((row) => (
            <div class="pricing-row">
              <span class="pricing-label">{row.label}</span>
              <span class="pricing-price">
                {row.price}
                {row.note && <span class="pricing-note">, {row.note}</span>}
              </span>
            </div>
          ))}
          <div class="pricing-row pricing-total">
            <span class="pricing-label">Total one-time investment</span>
            <span class="pricing-price">€2,500</span>
          </div>
        </div>

        <div class="addon-block" data-reveal>
          <h4>Optional add-ons</h4>
          <p class="addon-intro">Only pay for these if you want them, not part of the €2,500 base price.</p>
          <div class="pricing-table addon-table">
            {addonRows.map((row) => (
              <div class="pricing-row">
                <div class="pricing-label-group">
                  <span class="pricing-label">{row.label}</span>
                  {row.desc && <span class="pricing-desc">{row.desc}</span>}
                </div>
                <span class="pricing-price">
                  {row.price}
                  {row.note && <span class="pricing-note"> {row.note}</span>}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="payment-terms" data-reveal>
          <h4>Payment terms</h4>
          <p>50% to begin the project, 50% on final delivery, Sueste Creative's standard terms. Prices shown exclude applicable VAT (IVA). The deposit is non-refundable once work begins, if you cancel mid-project, completed work is delivered as-is.</p>
        </div>

        <div class="payment-terms" data-reveal>
          <h4>Revisions</h4>
          <p>2 rounds of design feedback are included in the base price. Additional rounds are billed hourly.</p>
        </div>

        <div class="payment-terms" data-reveal>
          <h4>Post-launch support</h4>
          <p>30 days of free bug-fix support after launch. New features or changes after that are quoted separately.</p>
        </div>

        <div class="payment-terms" data-reveal>
          <h4>Ownership</h4>
          <p>Full ownership of the site, code, and CMS transfers to you on final payment.</p>
        </div>
      </div>
    </section>

    <!-- NOT INCLUDED -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>What's not included</h2>
          <p>So there are no surprises, these are billed separately or handled by you.</p>
        </div>
        <div class="not-included-table" data-reveal>
          {notIncludedRows.map((row) => (
            <div class="ni-row">
              <span class="ni-label">{row.label}</span>
              <span class="ni-note">{row.note}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>Timeline</h2>
          <p>~4 weeks of active work. Calendar time may extend if the project overlaps Pedro's wedding window below.</p>
        </div>
        <div class="timeline" data-reveal>
          {(() => {
            let step = 0;
            return timeline.map((t) => {
              if (t.blackout) {
                return (
                  <div class="timeline-step timeline-blackout">
                    <div class="timeline-num timeline-num-blackout" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                      </svg>
                    </div>
                    <div class="timeline-body">
                      <span class="timeline-phase timeline-phase-blackout">{t.phase}</span>
                      <h4>{t.title}</h4>
                      <p>{t.desc}</p>
                    </div>
                  </div>
                );
              }
              step += 1;
              return (
                <div class="timeline-step">
                  <div class="timeline-num">{step}</div>
                  <div class="timeline-body">
                    <span class="timeline-phase">{t.phase}</span>
                    <h4>{t.title}</h4>
                    <p>{t.desc}</p>
                  </div>
                </div>
              );
            });
          })()}
        </div>
      </div>
    </section>

    <!-- SELECTION FORM -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>Build your package</h2>
          <p>Pick the optional add-ons you want, the €2,500 base is always included. Then send it to Pedro.</p>
        </div>

        <form id="kelly-form" class="kelly-form" data-reveal>
          <div class="kf-row pair">
            <div class="kf-field">
              <label for="kf-name">Your name</label>
              <input id="kf-name" name="name" type="text" required value="Kelly Swanson" />
            </div>
            <div class="kf-field">
              <label for="kf-email">Your email</label>
              <input id="kf-email" name="email" type="email" required value="portugalpropertyspecialist@gmail.com" />
            </div>
          </div>

          <div class="kf-option">
            <label class="kf-checkbox">
              <input type="checkbox" id="kf-advanced-crm" name="advancedCrm" />
              <span class="kf-checkbox-box"></span>
              <span class="kf-option-text">
                <strong>Advanced CRM</strong>Premium features beyond the basic pipeline
                <span class="kf-option-price">€500 – €1,000, depending on complexity</span>
              </span>
            </label>
          </div>

          <div class="kf-option kf-option-group">
            <span class="kf-group-label">Blog writing, do you want Sueste to write the posts?</span>
            <label class="kf-radio">
              <input type="radio" name="blogTier" value="none" checked />
              <span class="kf-radio-dot"></span>
              <span class="kf-option-text">No, I'll write my own posts</span>
            </label>
            <label class="kf-radio">
              <input type="radio" name="blogTier" value="1" />
              <span class="kf-radio-dot"></span>
              <span class="kf-option-text">1 post/week <span class="kf-option-price">€150/month</span></span>
            </label>
            <label class="kf-radio">
              <input type="radio" name="blogTier" value="2-3" />
              <span class="kf-radio-dot"></span>
              <span class="kf-option-text">2–3 posts/week <span class="kf-option-price">€300/month</span></span>
            </label>
            <label class="kf-radio">
              <input type="radio" name="blogTier" value="3+" />
              <span class="kf-radio-dot"></span>
              <span class="kf-option-text">3+ posts/week <span class="kf-option-price">€500/month</span></span>
            </label>
          </div>

          <div class="kf-option">
            <label class="kf-checkbox">
              <input type="checkbox" id="kf-brandbook" name="brandbook" />
              <span class="kf-checkbox-box"></span>
              <span class="kf-option-text">
                <strong>Brandbook</strong>Logo refinement, colors, typography, guidelines
                <span class="kf-option-price">Quoted separately</span>
              </span>
            </label>
          </div>

          <div class="kf-field">
            <label for="kf-notes">Anything else? (optional)</label>
            <textarea id="kf-notes" name="notes" rows="3"></textarea>
          </div>

          <input type="text" name="honey" class="kf-honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div id="kf-status" class="kf-status" role="status"></div>

          <button type="submit" id="kf-submit" class="kf-submit-btn">Send to Pedro by Email</button>

          <div class="kf-alt">
            <p>Prefer WhatsApp? Download a PDF summary, then attach it in the chat, wa.me links can't attach files automatically.</p>
            <div class="kf-alt-actions">
              <button type="button" id="kf-pdf-btn" class="kf-alt-btn">Download PDF summary</button>
              <button type="button" id="kf-wa-btn" class="kf-alt-btn kf-alt-btn-wa">Open WhatsApp</button>
            </div>
          </div>
        </form>
      </div>
    </section>

    <div id="kelly-print-summary">
      <h2>Sueste Creative, Proposal Selection</h2>
      <p class="kps-meta"></p>
      <div class="kps-body"></div>
    </div>

    <!-- NEXT STEPS -->
    <section class="section cta-section">
      <div class="container cta-inner" data-reveal>
        <h2>Ready to move forward?</h2>
        <p>
          Reply on WhatsApp to confirm, ask questions, or request changes to scope,
          this proposal is valid until {validUntil}.
        </p>
        <div class="cta-actions">
          <WhatsAppButton
            lang="en"
            source="quote_kelly_swanson"
            variant="cta"
            label="Confirm on WhatsApp"
            message="Hi Pedro, I've reviewed the proposal, let's move forward."
          />
          <a href="mailto:info@sueste-creative.pt?subject=Proposal%20-%20Kelly%20Swanson" class="email-link">
            or email info@sueste-creative.pt
          </a>
        </div>
        <div class="signature">
          <p>Prepared by</p>
          <strong>Sueste Creative Agency</strong>
          <span>Portimão, Algarve, Portugal</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .proposal-page {
    background-color: #050505;
    min-height: 100vh;
  }

  .bg-blob {
    position: fixed;
    top: -10%;
    left: -15%;
    width: 60vw;
    height: 60vw;
    max-width: 700px;
    max-height: 700px;
    background: radial-gradient(circle at 30% 30%, rgba(56, 189, 248, 0.35), transparent 70%);
    filter: blur(80px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    animation: blob-drift 22s ease-in-out infinite alternate;
  }

  @keyframes blob-drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(35vw, 25vh) scale(1.15); }
    100% { transform: translate(12vw, 45vh) scale(0.95); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-blob {
      animation: none;
    }
  }

  .proposal-header {
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    height: 132px;
    width: auto;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header-tag {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #71717a;
  }

  .header-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: #fff;
    color: #050505;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .header-pill:hover {
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .header-tag {
      display: none;
    }
  }

  /* HERO */
  .hero {
    position: relative;
    padding: 9rem 0 6rem;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.55) 0%, rgba(5, 5, 5, 0.65) 45%, #050505 95%),
      linear-gradient(90deg, rgba(5, 5, 5, 0.85) 0%, rgba(5, 5, 5, 0.35) 55%, rgba(5, 5, 5, 0.15) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(56, 189, 248, 0.07);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #38bdf8;
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 880px;
    margin-bottom: 1.5rem;
  }

  .hero-title .highlight {
    background: linear-gradient(135deg, #38bdf8 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #a1a1aa;
    max-width: 640px;
    line-height: 1.65;
    margin-bottom: 3rem;
  }

  .hero-dates {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-dates > div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .hero-dates .label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #52525b;
  }

  .hero-dates .value {
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* SECTIONS */
  .section {
    padding: 5rem 0;
  }

  .section-dark {
    background: rgba(255, 255, 255, 0.015);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .section-header {
    margin: 0 auto 2.5rem;
    max-width: 600px;
  }

  .section-header h2 {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
    background: linear-gradient(135deg, #fff 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    color: #71717a;
    font-size: 1.05rem;
  }

  /* UNDERSTANDING */
  .understanding-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 760px;
    margin: 0 auto;
  }

  .understanding-grid p {
    color: #d4d4d8;
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .understanding-grid strong {
    color: #fff;
  }

  /* FEATURE GRID */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: rgba(8, 10, 20, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s, transform 0.3s;
  }

  .feature-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    transform: translateY(-3px);
  }

  .feature-icon {
    width: 38px;
    height: 38px;
    color: var(--accent);
    margin-bottom: 1rem;
