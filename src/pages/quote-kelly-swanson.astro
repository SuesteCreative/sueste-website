    #kelly-print-summary h2 { margin-bottom: 0.5rem; }
    #kelly-print-summary .kps-meta { color: #555; font-size: 0.85rem; margin-bottom: 1.5rem; }
    #kelly-print-summary .kps-body p { margin-bottom: 0.6rem; font-size: 0.95rem; }
