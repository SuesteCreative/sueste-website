    gap: 0.85rem;
    cursor: pointer;
  }

  .kf-option-group .kf-radio {
    padding: 0.5rem 0;
  }

  .kf-checkbox input,
  .kf-radio input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .kf-checkbox-box {
    flex-shrink: 0;
