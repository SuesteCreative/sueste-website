---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const preparedDate = "June 23, 2026";
const validUntil = "July 23, 2026";

const features = [
  {
    accent: "#38bdf8",
    name: "Real Estate Website + Listings CMS",
    price: "€3,000",
    priceNote: "starting at",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 21V9h6v12"/><path d="M3 9h18"/>`,
    items: [
      "Custom-designed site built for international buyers",
      "Unlimited property listings — add, edit, remove yourself, no coding",
      "Property pages: photo gallery, map, price, features, status (For Sale / Sold / Reserved)",
      "Search & filter by location, price, bedrooms, type",
      "Mobile-first, fast-loading, SEO-structured",
    ],
  },
  {
    accent: "#6366f1",
    name: "Built-in CRM",
    price: "€3,000",
    priceNote: "starting at",
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>`,
    items: [
      "Every listing enquiry flows automatically into your private CRM",
      "Pipeline view: New → Contacted → Viewing → Offer → Closed",
      "Client database with notes and follow-up reminders",
      "No manual re-entry — website and CRM share one system",
    ],
  },
  {
    accent: "#fbbf24",
    name: "Blog Section",
    price: "Included",
    priceNote: "in the CMS build",
    icon: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
    items: [
      "Publish posts yourself — no developer needed",
      "Ideal for tax-regime guides per country, market updates, buyer guides",
      "SEO-structured templates with categories and tags",
    ],
  },
  {
    accent: "#34d399",
    name: "Paid Consulting Bookings",
    price: "€500",
    priceNote: "one-time setup",
    icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
    items: [
      "Dedicated \"Book a Consultation\" page",
      "Calendly embed for scheduling",
      "Stripe Checkout — clients pay upfront, session confirms automatically",
      "Automatic confirmation emails",
    ],
  },
  {
    accent: "#a78bfa",
    name: "SEO Foundations + Copywriting",
    price: "€550",
    priceNote: "starting at",
    icon: `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>`,
    items: [
      "On-page SEO setup: meta, schema, sitemaps — tuned for international property search",
      "Professional English copy for core pages (Home, About, Contact, Consulting)",
      "Property listing descriptions written by you or your team",
    ],
  },
];

const pricingRows = [
  { label: "Real Estate Website + Listings CMS", price: "€3,000", note: "starting at" },
  { label: "Built-in CRM (with integrations)", price: "€3,000", note: "starting at" },
  { label: "Blog Section", price: "Included", note: "" },
  { label: "Calendly + Stripe Consulting Bookings", price: "€500", note: "one-time setup" },
  { label: "SEO Foundations", price: "€300", note: "" },
  { label: "Professional Copywriting", price: "€250", note: "starting at" },
];

const timeline = [
  { phase: "Weeks 1–2", title: "Discovery & Design", desc: "Brand direction, sitemap, wireframes for listings and consulting pages." },
  { phase: "Weeks 2–4", title: "Website + Listings CMS Build", desc: "Full build of the site and the property management system you'll use daily." },
  { phase: "Weeks 4–5", title: "CRM + Calendly/Stripe Integration", desc: "Lead pipeline wired to your forms; consulting bookings go live with payment." },
  { phase: "Week 5–6", title: "Content, SEO, QA & Launch", desc: "Copy in place, SEO foundations applied, final testing, go live." },
];
---

<BaseLayout
  title="Proposal for Kelly Swanson"
  description="Business proposal and quote prepared by Sueste Creative Agency for Kelly Swanson — Portugal Property Specialist."
  lang="en"
  noindex={true}
>
  <main class="proposal-page">
    <header class="proposal-header">
      <div class="container header-inner">
        <img src="/images/logo-white-hor.webp" alt="Sueste Creative" class="logo" />
        <span class="header-tag">Business Proposal</span>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero">
      <img
        src="/images/quote-kelly/hero-villa.jpg"
        alt="Modern villa with infinity pool"
        class="hero-bg"
        fetchpriority="high"
      />
      <div class="hero-scrim"></div>
      <div class="container hero-content">
        <div class="hero-meta" data-reveal>
          <span class="eyebrow">Prepared for Kelly Swanson · Portugal Property Specialist</span>
        </div>
        <h1 class="hero-title" data-reveal>
          A real estate platform built to <span class="highlight">close more, manage less</span>
        </h1>
        <p class="hero-subtitle" data-reveal>
          A self-managed website with unlimited listings, a built-in CRM for every lead,
          a blog for your buyer guides, and a paid consulting booking flow — all in one system.
        </p>
        <div class="hero-dates" data-reveal>
          <div><span class="label">Prepared</span><span class="value">{preparedDate}</span></div>
          <div><span class="label">Valid until</span><span class="value">{validUntil}</span></div>
          <div><span class="label">Prepared by</span><span class="value">Sueste Creative Agency</span></div>
        </div>
      </div>
    </section>

    <!-- UNDERSTANDING -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>What we understood from our conversation</h2>
        </div>
        <div class="understanding-grid" data-reveal>
          <p>
            You work with property buyers from <strong>10–12 different countries</strong>, and what sets you
            apart is the personal relationship you build with each one. Your current setup makes it hard to
            scale that — listings need a developer to update, leads live in your inbox instead of a pipeline,
            and there's no easy way to turn your knowledge (like tax regimes for different nationalities) into
            content that brings buyers to you.
          </p>
          <p>
            This proposal is built around three goals: let you <strong>add and manage listings yourself</strong>,
            never lose a lead because it's not tracked anywhere, and let you charge for your time through paid,
            calendar-booked consultations.
          </p>
        </div>
      </div>
    </section>

    <!-- WHAT WE'LL BUILD -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>What we'll build</h2>
          <p>Five pieces, working as one system.</p>
        </div>
        <div class="feature-grid">
          {features.map((f) => (
            <div class="feature-card" data-reveal style={`--accent:${f.accent}`}>
              <div class="feature-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
              </div>
              <h3>{f.name}</h3>
              <ul>
                {f.items.map((item) => <li>{item}</li>)}
              </ul>
              <div class="feature-price">
                <span class="price">{f.price}</span>
                {f.priceNote && <span class="price-note">{f.priceNote}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INVESTMENT -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>Investment</h2>
          <p>Based on our rate card. Final pricing may be adjusted once full scope is confirmed.</p>
        </div>
        <div class="pricing-table" data-reveal>
          {pricingRows.map((row) => (
            <div class="pricing-row">
              <span class="pricing-label">{row.label}</span>
              <span class="pricing-price">
                {row.price}
                {row.note && <span class="pricing-note"> — {row.note}</span>}
              </span>
            </div>
          ))}
          <div class="pricing-row pricing-total">
            <span class="pricing-label">Total one-time investment</span>
            <span class="pricing-price">€7,050 <span class="pricing-note">starting at</span></span>
          </div>
        </div>
        <div class="payment-terms" data-reveal>
          <h4>Payment terms</h4>
          <p>50% to begin the project, 50% on final delivery — Sueste Creative's standard terms. Prices shown exclude applicable VAT (IVA).</p>
        </div>
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="section section-dark">
      <div class="container">
        <div class="section-header" data-reveal>
          <h2>Timeline</h2>
          <p>From kickoff to launch in roughly 6 weeks.</p>
        </div>
        <div class="timeline" data-reveal>
          {timeline.map((t, i) => (
            <div class="timeline-step">
              <div class="timeline-num">{i + 1}</div>
              <div class="timeline-body">
                <span class="timeline-phase">{t.phase}</span>
                <h4>{t.title}</h4>
                <p>{t.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- NEXT STEPS -->
    <section class="section cta-section">
      <div class="container cta-inner" data-reveal>
        <h2>Ready to move forward?</h2>
        <p>
          Reply on WhatsApp to confirm, ask questions, or request changes to scope —
          this proposal is valid until {validUntil}.
        </p>
        <div class="cta-actions">
          <WhatsAppButton
            lang="en"
            source="quote_kelly_swanson"
            variant="cta"
            label="Confirm on WhatsApp"
            message="Hi Pedro, I've reviewed the proposal — let's move forward."
          />
          <a href="mailto:info@sueste-creative.pt?subject=Proposal%20-%20Kelly%20Swanson" class="email-link">
            or email info@sueste-creative.pt
          </a>
        </div>
        <div class="signature">
          <p>Prepared by</p>
          <strong>Sueste Creative Agency</strong>
          <span>Portimão, Algarve, Portugal</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .proposal-page {
    background-color: #050505;
    min-height: 100vh;
  }

  .proposal-header {
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    height: 28px;
    width: auto;
  }

  .header-tag {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #71717a;
  }

  /* HERO */
  .hero {
    position: relative;
    padding: 9rem 0 6rem;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.55) 0%, rgba(5, 5, 5, 0.65) 45%, #050505 95%),
      linear-gradient(90deg, rgba(5, 5, 5, 0.85) 0%, rgba(5, 5, 5, 0.35) 55%, rgba(5, 5, 5, 0.15) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(56, 189, 248, 0.07);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #38bdf8;
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 880px;
    margin-bottom: 1.5rem;
  }

  .hero-title .highlight {
    background: linear-gradient(135deg, #38bdf8 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #a1a1aa;
    max-width: 640px;
    line-height: 1.65;
    margin-bottom: 3rem;
  }

  .hero-dates {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-dates > div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .hero-dates .label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #52525b;
  }

  .hero-dates .value {
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* SECTIONS */
  .section {
    padding: 5rem 0;
  }

  .section-dark {
    background: rgba(255, 255, 255, 0.015);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .section-header {
    margin-bottom: 2.5rem;
    max-width: 600px;
  }

  .section-header h2 {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
    background: linear-gradient(135deg, #fff 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    color: #71717a;
    font-size: 1.05rem;
  }

  /* UNDERSTANDING */
  .understanding-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 760px;
  }

  .understanding-grid p {
    color: #d4d4d8;
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .understanding-grid strong {
    color: #fff;
  }

  /* FEATURE GRID */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: rgba(8, 10, 20, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s, transform 0.3s;
  }

  .feature-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    transform: translateY(-3px);
  }

  .feature-icon {
    width: 38px;
    height: 38px;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.9rem;
  }

  .feature-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .feature-card li {
    font-size: 0.9rem;
    color: #a1a1aa;
    line-height: 1.5;
    padding-left: 1.1rem;
    position: relative;
  }

  .feature-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .feature-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .feature-price .price {
    font-size: 1.3rem;
    font-weight: 800;
    color: #fff;
  }

  .feature-price .price-note {
    font-size: 0.78rem;
    color: #52525b;
  }

  /* PRICING TABLE */
  .pricing-table {
    max-width: 720px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }

  .pricing-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .pricing-row:last-child {
    border-bottom: none;
  }

  .pricing-label {
    font-size: 1rem;
    color: #d4d4d8;
  }

  .pricing-price {
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
  }

  .pricing-note {
    font-weight: 400;
    font-size: 0.82rem;
    color: #52525b;
  }

  .pricing-total {
    background: rgba(56, 189, 248, 0.06);
  }

  .pricing-total .pricing-label {
    font-weight: 700;
    color: #fff;
  }

  .pricing-total .pricing-price {
    font-size: 1.3rem;
    color: #38bdf8;
  }

  .payment-terms {
    max-width: 720px;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .payment-terms h4 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .payment-terms p {
    font-size: 0.9rem;
    color: #71717a;
    line-height: 1.6;
  }

  /* TIMELINE */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 760px;
  }

  .timeline-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .timeline-num {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .timeline-phase {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #52525b;
    font-weight: 700;
  }

  .timeline-body h4 {
    font-size: 1.05rem;
    margin: 0.3rem 0 0.4rem;
  }

  .timeline-body p {
    font-size: 0.9rem;
    color: #71717a;
    line-height: 1.55;
  }

  /* CTA */
  .cta-section {
    text-align: center;
  }

  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-inner h2 {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .cta-inner p {
    color: #a1a1aa;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .email-link {
    font-size: 0.9rem;
    color: #71717a;
  }

  .email-link:hover {
    color: #38bdf8;
  }

  .signature {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .signature p {
    font-size: 0.8rem;
    color: #52525b;
    margin-bottom: 0.2rem;
  }

  .signature strong {
    font-size: 1.05rem;
  }

  .signature span {
    font-size: 0.85rem;
    color: #71717a;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 0 3rem;
      min-height: 80vh;
    }
    .hero-scrim {
      background:
        linear-gradient(180deg, rgba(5, 5, 5, 0.6) 0%, rgba(5, 5, 5, 0.7) 50%, #050505 96%);
    }
    .hero-dates {
      gap: 1.5rem;
    }
    .section {
      padding: 3.5rem 0;
    }
  }
</style>
