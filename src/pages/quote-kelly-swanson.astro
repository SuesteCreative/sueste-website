    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .kf-alt p {
    font-size: 0.85rem;
    color: #71717a;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .kf-alt-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .kf-alt-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #d4d4d8;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.65rem 1.2rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .kf-alt-btn:hover {
    border-color: #38bdf8;
    color: #38bdf8;
  }

  .kf-alt-btn-wa:hover {
