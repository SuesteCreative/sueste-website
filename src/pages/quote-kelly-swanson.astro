  /* TIMELINE */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 760px;
    margin: 0 auto;
  }

  .timeline-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .timeline-num {
    flex-shrink: 0;
    width: 36px;
