</style>

<script>
  const BLOG_LABELS: Record<string, string> = {
    none: "No, I'll write my own posts",
    "1": "1 post/week, €150/month",
    "2-3": "2–3 posts/week, €300/month",
    "3+": "3+ posts/week, €500/month",
  };

  function getSelections() {
    const form = document.getElementById("kelly-form") as HTMLFormElement;
    const name = (form.querySelector('[name="name"]') as HTMLInputElement)?.value || "";
    const email = (form.querySelector('[name="email"]') as HTMLInputElement)?.value || "";
    const advancedCrm = (form.querySelector('[name="advancedCrm"]') as HTMLInputElement)?.checked || false;
    const blogTier = (form.querySelector('[name="blogTier"]:checked') as HTMLInputElement)?.value || "none";
    const brandbook = (form.querySelector('[name="brandbook"]') as HTMLInputElement)?.checked || false;
    const notes = (form.querySelector('[name="notes"]') as HTMLTextAreaElement)?.value || "";
    const honey = (form.querySelector('[name="honey"]') as HTMLInputElement)?.value || "";
    const refSite1 = (document.getElementById("kf-ref-1") as HTMLInputElement)?.value || "";
    const refSite2 = (document.getElementById("kf-ref-2") as HTMLInputElement)?.value || "";
    const refSite3 = (document.getElementById("kf-ref-3") as HTMLInputElement)?.value || "";
    return { name, email, advancedCrm, blogTier, brandbook, notes, honey, refSite1, refSite2, refSite3 };
  }

  function buildSummaryLines(sel: ReturnType<typeof getSelections>): string[] {
    const refSites = [sel.refSite1, sel.refSite2, sel.refSite3].filter(Boolean);
    return [
      `Name: ${sel.name}`,
      `Email: ${sel.email}`,
      `Base platform: €2,500 (website + CMS + CRM + Calendly/Stripe + SEO/GEO + blog), always included`,
      `Advanced CRM add-on: ${sel.advancedCrm ? "Yes, quote €500–€1,000 depending on complexity" : "No"}`,
      `Blog writing plan: ${BLOG_LABELS[sel.blogTier] || "Not specified"}`,
      `Brandbook: ${sel.brandbook ? "Yes, quoted separately" : "No"}`,
      ...(refSites.length ? [`Websites she likes: ${refSites.join(", ")}`] : []),
      ...(sel.notes ? [`Notes: ${sel.notes}`] : []),
    ];
  }

  function initKellyForm() {
    const form = document.getElementById("kelly-form") as HTMLFormElement | null;
    if (!form) return;

    const statusEl = document.getElementById("kf-status") as HTMLElement;
    const submitBtn = document.getElementById("kf-submit") as HTMLButtonElement;
    const pdfBtn = document.getElementById("kf-pdf-btn") as HTMLButtonElement;
    const waBtn = document.getElementById("kf-wa-btn") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const sel = getSelections();
      if (sel.honey) return;

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";
      statusEl.textContent = "";
      statusEl.className = "kf-status";

      try {
        const res = await fetch("/api/kelly-selection", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(sel),
        });
        const result = await res.json();
        if (result.success) {
          statusEl.textContent = "Sent! Pedro will get back to you shortly.";
          statusEl.className = "kf-status success";
        } else {
          statusEl.textContent = result.error || "Something went wrong. Try WhatsApp instead.";
          statusEl.className = "kf-status error";
        }
      } catch {
        statusEl.textContent = "Connection error. Try WhatsApp instead.";
        statusEl.className = "kf-status error";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send to Pedro by Email";
      }
    });

    pdfBtn?.addEventListener("click", () => {
      const sel = getSelections();
      const lines = buildSummaryLines(sel);
      const summaryEl = document.getElementById("kelly-print-summary");
      if (!summaryEl) return;
      const meta = summaryEl.querySelector(".kps-meta") as HTMLElement;
      const body = summaryEl.querySelector(".kps-body") as HTMLElement;
      meta.textContent = `Prepared for ${sel.name || "Kelly Swanson"} · ${new Date().toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}`;
      body.innerHTML = lines.map((l) => `<p>${l}</p>`).join("");
      window.print();
    });

    waBtn?.addEventListener("click", () => {
      const sel = getSelections();
      const lines = buildSummaryLines(sel);
      const text = `Hi Pedro, here's my project selection for the Sueste Creative proposal:\n\n${lines.join("\n")}\n\n(PDF summary attached)`;
      const url = `https://wa.me/351935473141?text=${encodeURIComponent(text)}`;
      window.open(url, "_blank", "noopener,noreferrer");
    });
  }

  initKellyForm();
  document.addEventListener("astro:after-swap", initKellyForm);
