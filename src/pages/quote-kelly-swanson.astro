    overflow: hidden;
  }

  .ni-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .ni-row:last-child {
    border-bottom: none;
  }

  .ni-label {
