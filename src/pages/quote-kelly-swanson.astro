  }

  .kf-status.success { color: #34d399; }
  .kf-status.error { color: #f87171; }

  .kf-submit-btn {
    background: linear-gradient(135deg, #38bdf8 0%, #2563eb 100%);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.9rem 1.5rem;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s, transform 0.3s;
  }

  .kf-submit-btn:hover { opacity: 0.88; transform: translateY(-1px); }
  .kf-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .kf-alt {
