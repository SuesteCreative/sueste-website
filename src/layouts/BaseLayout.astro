---
import "../styles/global.css";
import { getLangFromUrl } from "../utils/i18n";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  hreflangPt?: string;
  hreflangEn?: string;
  preloadImage?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Sueste Creative - Creative Agency",
  lang: propLang,
  hreflangPt,
  hreflangEn,
  preloadImage,
  ogImage = "https://sueste-creative.pt/images/og-preview.jpg",
  noindex = false,
} = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, "https://sueste-creative.pt");
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Google Analytics — loaded only after cookie consent (see CookieBanner) -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Sueste Creative</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {hreflangPt && <link rel="alternate" hreflang="pt" href={hreflangPt} />}
    {hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
    {hreflangPt && <link rel="alternate" hreflang="x-default" href={hreflangPt} />}

    <meta name="author" content="Sueste Creative" />
    <meta name="google-site-verification" content="google7348f8fd72de5796" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, Instagram, TikTok, LinkedIn, WhatsApp) -->
    <meta property="og:title" content={`${title} | Sueste Creative`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "pt_PT"} />
    <meta property="og:site_name" content="Sueste Creative" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Sueste Creative`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />

    <!-- SEO: JSON-LD Schema -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": ["LocalBusiness", "ProfessionalService"],
        name: "Sueste Creative",
        alternateName: "Sueste Creative Agency",
        url: "https://sueste-creative.pt",
        logo: "https://sueste-creative.pt/images/logo-white-hor.webp",
        image: "https://sueste-creative.pt/images/logo-white-hor.webp",
        description: description,
        telephone: "+351965494727",
        email: "info@sueste-creative.pt",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Portimão",
          addressRegion: "Algarve",
          addressCountry: "PT",
        },
        areaServed: [
          { "@type": "AdministrativeArea", name: "Algarve" },
          { "@type": "City", name: "Lisboa" },
          { "@type": "Country", name: "Portugal" },
        ],
        sameAs: [
          "https://www.instagram.com/sueste.agency/",
          "https://www.facebook.com/sueste.agency",
          "https://linkedin.com/company/sueste-creative",
        ],
      })}
    ></script>
  </head>
  <body>
    <div class="bg-blob-container">
      <div class="bg-blob"></div>
      <div class="bg-blob-2"></div>
    </div>
    <slot />

    <div id="wave-curtain" aria-hidden="true">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path class="wave-fill" d="M0,0 L100,0 L100,100 L0,100 Z" />
        <path class="wave-edge" d="" fill="none" stroke="currentColor" />
      </svg>
    </div>

    <CookieBanner lang={lang} />

    <script>
      // Load and Initialize Lenis & GSAP interactions
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Setup smooth scrolling for the entire app
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: "vertical",
        gestureOrientation: "vertical",
        smoothWheel: true,
        wheelMultiplier: 1,
        infinite: false,
      });

      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Handle Astro view transitions if used in future
      document.addEventListener("astro:after-swap", () => {
        // You could re-init Lenis here if the DOM swaps heavily
      });

      // ---- Ocean-wave curtain page transition ----
      const curtain = document.getElementById("wave-curtain");
      const waveEdgePath = curtain?.querySelector<SVGPathElement>(".wave-edge");
      const waveFillPath = curtain?.querySelector<SVGPathElement>(".wave-fill");
      const prefersReduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Build a wavy diagonal edge across a 100x100 viewBox.
      // The edge runs TL-ish to BR-ish with a sine-scalloped offset,
      // fill covers the BR side of the edge.
      function buildWavePaths(phase = 0) {
        if (!waveEdgePath || !waveFillPath) return;
        const segments = 28;
        const amplitude = 6;   // viewBox units
        const frequency = 2.4; // full sine cycles across the edge

        type Pt = { x: number; y: number };
        const pts: Pt[] = [];
        for (let i = 0; i <= segments; i++) {
          const t = i / segments;
          // Diagonal baseline from (-5, -5) to (105, 105) so ends extend off-canvas.
          const bx = -5 + t * 110;
          const by = -5 + t * 110;
          // Perpendicular to the diagonal (unit vector 1/sqrt2 each axis).
          const off = Math.sin(t * Math.PI * 2 * frequency + phase) * amplitude;
          pts.push({ x: bx + off * 0.7071, y: by - off * 0.7071 });
        }

        const edgeD =
          "M " + pts.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(" L ");
        // Fill polygon: the wavy edge plus the BR corner so everything below/right is painted.
        const fillD =
          edgeD + ` L 110,-5 L 110,110 L -5,110 Z`;

        waveEdgePath.setAttribute("d", edgeD);
        waveFillPath.setAttribute("d", fillD);
      }
      buildWavePaths();
      window.addEventListener("resize", () => buildWavePaths(), { passive: true });

      function playExit() {
        if (!curtain) return;
        gsap.set(curtain, { xPercent: 0, yPercent: 0 });
        gsap.to(curtain, {
          xPercent: 110,
          yPercent: 110,
          duration: 0.75,
          ease: "power2.inOut",
          onComplete: () => {
            curtain.classList.remove("is-active");
            gsap.set(curtain, { xPercent: -110, yPercent: -110 });
            lenis.start();
          },
        });
      }

      function playEntry(onDone: () => void) {
        if (!curtain) { onDone(); return; }
        curtain.classList.add("is-active");
        lenis.stop();
        gsap.set(curtain, { xPercent: -110, yPercent: -110 });
        gsap.to(curtain, {
          xPercent: 0,
          yPercent: 0,
          duration: 0.7,
          ease: "power2.inOut",
          onComplete: onDone,
        });
      }

      if (!prefersReduced && curtain) {
        // Exit leg — continuation of a transition started on the previous page.
        if (sessionStorage.getItem("wave:exit") === "1") {
          sessionStorage.removeItem("wave:exit");
          playExit();
        } else {
          gsap.set(curtain, { xPercent: -110, yPercent: -110 });
        }

        // Entry leg — intercept internal link clicks.
        document.addEventListener(
          "click",
          (e) => {
            const mouseEvt = e as MouseEvent;
            if (
              mouseEvt.button !== 0 ||
              mouseEvt.metaKey ||
              mouseEvt.ctrlKey ||
              mouseEvt.shiftKey ||
              mouseEvt.altKey
            )
              return;

            const target = e.target as HTMLElement | null;
            if (!target) return;
            const a = target.closest("a");
            if (!a) return;

            const href = a.getAttribute("href");
            if (!href) return;
            if (a.target === "_blank") return;
            if (a.hasAttribute("download")) return;
            if (!href.startsWith("/")) return; // external, mailto:, tel:, hash
            if (href.startsWith("//")) return; // protocol-relative external

            // Same-URL navigation — let the browser handle (likely scroll/no-op).
            if (a.href === window.location.href) return;

            e.preventDefault();
            playEntry(() => {
              sessionStorage.setItem("wave:exit", "1");
              window.location.href = href;
            });
          },
          { capture: true }
        );

        // bfcache restore — wipe any stale curtain state.
        window.addEventListener("pageshow", (e) => {
          if ((e as PageTransitionEvent).persisted) {
            gsap.set(curtain, { xPercent: -110, yPercent: -110 });
            curtain.classList.remove("is-active");
            sessionStorage.removeItem("wave:exit");
            lenis.start();
          }
        });
      }
      // ---- end curtain ----

      // Masterful Reveal System that we left working
      const revealCallback = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
          }
        });
      };

      const revealObserver = new IntersectionObserver(revealCallback, {
        threshold: 0.15,
        rootMargin: "0px 0px -50px 0px",
      });

      document.querySelectorAll("[data-reveal]").forEach((el) => {
        revealObserver.observe(el);
      });

      document.addEventListener("astro:after-swap", () => {
        document
          .querySelectorAll("[data-reveal]")
          .forEach((el) => revealObserver.observe(el));
      });
    </script>
  </body>
</html>
