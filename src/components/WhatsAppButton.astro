---
interface Props {
  lang?: string;
  source: string;
  variant?: "inline" | "cta";
  message?: string;
  label?: string;
}

const { lang = "pt", source, variant = "inline", message, label } = Astro.props;

const phone = "351935473141";
const defaultMessage =
  lang === "en"
    ? "Hi Pedro, I saw the Sueste Creative website and would like to..."
    : "Olá Pedro, vi o site da Sueste Creative e gostaria de...";
const defaultLabel = lang === "en" ? "Chat on WhatsApp" : "Falar no WhatsApp";

const text = message ?? defaultMessage;
const buttonLabel = label ?? defaultLabel;
const href = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
---

<a
  class={`wa-btn wa-btn--${variant}`}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-wa-source={source}
>
  <svg
    viewBox="0 0 32 32"
    width="20"
    height="20"
    aria-hidden="true"
    fill="currentColor"
  >
    <path d="M19.11 17.205c-.372 0-1.088 1.39-1.518 1.39a.63.63 0 0 1-.315-.1c-.802-.402-1.504-.817-2.163-1.447-.545-.516-1.146-1.29-1.46-1.963a.426.426 0 0 1-.073-.215c0-.33.99-.945.99-1.49 0-.143-.73-2.09-.832-2.335-.143-.372-.214-.487-.6-.487-.187 0-.36-.043-.53-.043-.302 0-.53.115-.746.315-.688.645-1.04 1.397-1.04 2.335 0 .856.458 1.735 1.017 2.556C12.98 17.47 15.04 19.23 17.64 20c.915.272 1.562.314 2.2.314.89 0 1.937-.458 2.26-1.185.1-.23.1-.43.1-.645 0-.143-.043-.286-.07-.43-.086-.415-1.53-1.13-1.898-1.29-.33-.145-.715-.56-1.122-.56zm-2.95 7.44c-1.572 0-3.114-.43-4.454-1.237l-3.114.817.83-3.029a8.67 8.67 0 0 1-1.353-4.64c0-4.786 3.91-8.684 8.697-8.684 2.32 0 4.49.898 6.13 2.54a8.633 8.633 0 0 1 2.54 6.145c0 4.786-3.91 8.69-8.696 8.69h-.57zm7.4-16.07A10.385 10.385 0 0 0 16.148 5.5c-5.76 0-10.447 4.688-10.447 10.448 0 1.84.487 3.638 1.405 5.222L5.5 26.5l5.46-1.432a10.425 10.425 0 0 0 4.988 1.27h.007c5.76 0 10.447-4.687 10.447-10.447a10.386 10.386 0 0 0-3.05-7.415z"></path>
  </svg>
  <span>{buttonLabel}</span>
</a>

<style>
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #25d366;
    font-weight: 500;
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .wa-btn:hover {
    color: #1ebe5a;
    transform: translateY(-1px);
  }

  .wa-btn--inline {
    font-size: 1.05rem;
  }

  .wa-btn--cta {
    padding: 0.85rem 1.6rem;
    border-radius: 50px;
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.4);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .wa-btn--cta:hover {
    background: rgba(37, 211, 102, 0.2);
    border-color: rgba(37, 211, 102, 0.7);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.25);
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-wa-source]").forEach((el) => {
    el.addEventListener("click", () => {
      const source = el.dataset.waSource ?? "unknown";
      const w = window as unknown as { gtag?: (...args: unknown[]) => void };
      if (typeof w.gtag === "function") {
        w.gtag("event", "whatsapp_click", {
          event_category: "engagement",
          event_label: source,
        });
      }
    });
  });
</script>
