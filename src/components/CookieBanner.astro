---
const { lang = "pt" } = Astro.props;
const isPt = lang !== "en";

const text = {
  message: isPt
    ? "Utilizamos cookies para analisar o tráfego do website (Google Analytics). Pode aceitar ou recusar cookies não essenciais."
    : "We use cookies to analyse website traffic (Google Analytics). You can accept or decline non-essential cookies.",
  accept: isPt ? "Aceitar" : "Accept",
  decline: isPt ? "Recusar" : "Decline",
  learnMore: isPt ? "Saber mais" : "Learn more",
  learnMoreHref: isPt ? "/cookies" : "/en/cookies",
};
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent" aria-live="polite">
  <p class="cookie-message">
    {text.message}
    <a href={text.learnMoreHref}>{text.learnMore}</a>.
  </p>
  <div class="cookie-actions">
    <button id="cookie-decline" class="cookie-btn cookie-btn--decline">{text.decline}</button>
    <button id="cookie-accept" class="cookie-btn cookie-btn--accept">{text.accept}</button>
  </div>
</div>

<script>
  const CONSENT_KEY = "cookie_consent";
  const GA_ID = "G-RE740MRY5Y";

  function initGA() {
    if ((window as any).__gaLoaded) return;
    (window as any).__gaLoaded = true;

    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script);

    (window as any).dataLayer = (window as any).dataLayer || [];
    function gtag(...args: any[]) { (window as any).dataLayer.push(args); }
    (window as any).gtag = gtag;
    gtag("js", new Date());
    gtag("config", GA_ID);
  }

  function hideBanner() {
    const banner = document.getElementById("cookie-banner");
    if (banner) {
      banner.style.transition = "opacity 0.3s ease, transform 0.3s ease";
      banner.style.opacity = "0";
      banner.style.transform = "translateY(12px)";
      setTimeout(() => banner.remove(), 320);
    }
  }

  // On load — check stored preference
  const stored = localStorage.getItem(CONSENT_KEY);
  if (stored === "accepted") {
    initGA();
    document.getElementById("cookie-banner")?.remove();
  } else if (stored === "declined") {
    document.getElementById("cookie-banner")?.remove();
  }
  // else: show banner (default)

  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "accepted");
    initGA();
    hideBanner();
  });

  document.getElementById("cookie-decline")?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "declined");
    hideBanner();
  });
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: min(560px, calc(100vw - 2rem));
    background: rgba(15, 23, 42, 0.96);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    box-shadow: 0 8px 40px rgba(0,0,0,0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .cookie-message {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.5;
    flex: 1;
  }

  .cookie-message a {
    color: #38bdf8;
    text-decoration: underline;
    white-space: nowrap;
  }

  .cookie-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    padding: 0.5rem 1.1rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    font-family: inherit;
    white-space: nowrap;
  }

  .cookie-btn--accept {
    background: #38bdf8;
    color: #0f172a;
  }

  .cookie-btn--accept:hover {
    background: #7dd3fc;
  }

  .cookie-btn--decline {
    background: transparent;
    color: rgba(255,255,255,0.5);
    border: 1px solid rgba(255,255,255,0.15);
  }

  .cookie-btn--decline:hover {
    color: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.3);
  }

  @media (max-width: 500px) {
    .cookie-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .cookie-actions {
      width: 100%;
      justify-content: flex-end;
    }
  }
</style>
