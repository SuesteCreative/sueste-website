    },
];
---

<div class="bento-container" id="bento-services">
    <div class="bento-grid">
        {
            services.map((service, index) => {
                const Tag = service.partner ? "a" : "div";
                const extraProps = service.partner ? { href: service.href } : {};
                return (
                    <Tag
                        class={`bento-card magnetic-card reveal-delay-${(index % 3) + 1}${service.partner ? " bento-partner" : ""}`}
                        data-reveal
                        data-accent={service.accent}
                        style={`--accent: ${service.accent};`}
                        {...extraProps}
                    >
                        <div class="bento-glow" />
                        <div class="bento-icon-bg" set:html={service.iconBig} />
                        {service.partner && service.partnerLogo && (
                            <img
                                class="bento-partner-logo"
                                src={service.partnerLogo}
                                alt={service.partnerName}
                                loading="lazy"
                            />
                        )}
                        <div class="bento-content">
                            <div class="bento-label">
                                <span class="bento-icon-small" set:html={service.icon} />
                            </div>
                            {service.partner && (
                                <span class="bento-partner-kicker">
                                    {pt ? "Parceria" : "Partnership"} · {service.partnerName}
                                </span>
                            )}
                            <h3>{pt ? service.titlePt : service.titleEn}</h3>
                            <p>{pt ? service.descPt : service.descEn}</p>
                            {service.partner && (
                                <span class="bento-partner-cta">
                                    {pt ? "Ver parceria" : "View partnership"}
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="7" y1="17" x2="17" y2="7" />
                                        <polyline points="7 7 17 7 17 17" />
                                    </svg>
                                </span>
                            )}
                        </div>
                    </Tag>
                );
            })
        }
    </div>
</div>

<style>
    .bento-container {
        width: 100%;
        margin-top: 3rem;
    }

    .bento-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: minmax(280px, auto);
        gap: 1.5rem;
    }

    .bento-card {
        position: relative;
        border-radius: 24px;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.07);
        transition:
            transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275),
            border-color 0.4s ease,
            box-shadow 0.4s ease;
        will-change: transform;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

    /* Accent border glow on hover */
    .bento-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 24px;
        padding: 1px;
        background: linear-gradient(
            135deg,
            transparent 0%,
            var(--accent, #38bdf8) 50%,
            transparent 100%
        );
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 1;
        pointer-events: none;
    }

    .bento-card:hover::before {
        opacity: 1;
    }

    .bento-card:hover {
        box-shadow: 0 0 40px -10px var(--accent, #38bdf8);
        border-color: rgba(255, 255, 255, 0.12);
    }

    /* Partner card — subtle accent tint */
    .bento-partner {
        background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--accent, #ec4899) 6%, rgba(255, 255, 255, 0.03)) 0%,
            rgba(255, 255, 255, 0.02) 100%
        );
    }

    /* Large decorative icon in background */
    .bento-icon-bg {
        position: absolute;
        bottom: -1rem;
        right: -1rem;
        width: 200px;
        height: 200px;
        color: var(--accent, #38bdf8);
        opacity: 0.05;
        pointer-events: none;
        z-index: 0;
        transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .bento-card:hover .bento-icon-bg {
        opacity: 0.1;
        transform: scale(1.08) rotate(-5deg);
    }

    /* Partner logo badge, top-right */
    .bento-partner-logo {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        width: 90px;
        height: auto;
        max-height: 42px;
        object-fit: contain;
        opacity: 0.75;
        z-index: 2;
        pointer-events: none;
        transition: opacity 0.35s ease;
    }

    .bento-partner:hover .bento-partner-logo {
        opacity: 1;
    }

    /* Small icon label */
    .bento-label {
        margin-bottom: 1rem;
    }

    .bento-icon-small {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--accent, #38bdf8) 15%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent, #38bdf8) 30%, transparent);
        color: var(--accent, #38bdf8);
        padding: 10px;
        transition: background 0.3s ease, transform 0.3s ease;
    }

    .bento-card:hover .bento-icon-small {
        background: color-mix(in srgb, var(--accent, #38bdf8) 25%, transparent);
        transform: scale(1.1);
    }

    /* Mouse-follow glow blob */
    .bento-glow {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent, #38bdf8) 20%, transparent) 0%,
            transparent 70%
        );
        border-radius: 50%;
        top: -175px;
        left: -175px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: 0;
        transform: translate(var(--mouse-x, 0), var(--mouse-y, 0));
    }

    .bento-card:hover .bento-glow {
        opacity: 1;
    }

    .bento-content {
        position: relative;
        z-index: 2;
        pointer-events: none;
    }

    .bento-partner-kicker {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent, #ec4899);
        margin-bottom: 0.6rem;
        padding: 0.3rem 0.7rem;
        border-radius: 50px;
        background: color-mix(in srgb, var(--accent, #ec4899) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent, #ec4899) 30%, transparent);
    }

    .bento-card h3 {
        font-size: clamp(1.4rem, 2.4vw, 1.75rem);
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .bento-card p {
        font-size: 1rem;
        color: #a1a1aa;
        line-height: 1.6;
    }

    .bento-partner-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--accent, #ec4899);
        letter-spacing: 0.02em;
    }

    @media (max-width: 1024px) {
        .bento-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 700px) {
        .bento-grid {
            grid-template-columns: 1fr;
        }
        .bento-card {
            padding: 2rem;
        }
        .bento-partner-logo {
            width: 70px;
            max-height: 34px;
            top: 1.2rem;
            right: 1.2rem;
        }
    }
</style>

<script>
    import { gsap } from "gsap";

    document.querySelectorAll(".magnetic-card").forEach((card) => {
        const el = card as HTMLElement;

        el.addEventListener("mousemove", (e) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            el.style.setProperty("--mouse-x", `${x - 175}px`);
            el.style.setProperty("--mouse-y", `${y - 175}px`);

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            gsap.to(el, {
                duration: 0.5,
                rotateX: (y - centerY) / 20,
                rotateY: (centerX - x) / 20,
                transformPerspective: 1000,
                ease: "power2.out",
            });
        });

        el.addEventListener("mouseleave", () => {
            gsap.to(el, {
                duration: 0.7,
                rotateX: 0,
                rotateY: 0,
                ease: "elastic.out(1, 0.3)",
            });
        });
    });
</script>
